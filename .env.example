# ============================================================
# QuantiByte POS System - Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# ============================================================
# GLOBAL
# ============================================================
NODE_ENV=development

# ============================================================
# SHARED SECRETS (same value used across all services)
# ============================================================
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_random_secret
REFRESH_TOKEN_SECRET=replace_with_64_char_random_secret
ENCRYPTION_KEY=replace_with_32_char_hex_key
INTERNAL_SERVICE_SECRET=replace_with_strong_internal_secret

# ============================================================
# INFRASTRUCTURE
# ============================================================

REDIS_URL=redis://localhost:6379
KAFKA_BROKER_URL=localhost:9092

# Docker Compose Postgres credentials
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=pos_password

# ============================================================
# DATABASE URLs (one PostgreSQL DB per service)
# Ports match docker-compose.yml port mappings
# ============================================================

AUTH_DB_URL=postgresql://pos_user:pos_password@localhost:5433/pos_auth
MENU_DB_URL=postgresql://pos_user:pos_password@localhost:5434/pos_menu
ORDER_DB_URL=postgresql://pos_user:pos_password@localhost:5435/pos_orders
INVENTORY_DB_URL=postgresql://pos_user:pos_password@localhost:5436/pos_inventory
PAYMENT_DB_URL=postgresql://pos_user:pos_password@localhost:5437/pos_payments
CUSTOMER_DB_URL=postgresql://pos_user:pos_password@localhost:5438/pos_customers
MARKETING_DB_URL=postgresql://pos_user:pos_password@localhost:5439/pos_marketing
REPORTING_DB_URL=postgresql://pos_user:pos_password@localhost:5440/pos_reporting
STORE_DB_URL=postgresql://pos_user:pos_password@localhost:5432/pos_store
SYNC_DB_URL=postgresql://pos_user:pos_password@localhost:5441/pos_sync
CHURN_DB_URL=postgresql://pos_user:pos_password@localhost:5442/pos_churn
RESERVATION_DB_URL=postgresql://pos_user:pos_password@localhost:5443/pos_reservations
STAFF_DB_URL=postgresql://pos_user:pos_password@localhost:5444/pos_staff_optimization

# ============================================================
# SERVICE PORTS
# ============================================================

API_GATEWAY_PORT=3000
ORDER_SERVICE_PORT=3001
INVENTORY_SERVICE_PORT=3002
PAYMENT_SERVICE_PORT=3003
AUTH_SERVICE_PORT=3004
MENU_SERVICE_PORT=3005
SYNC_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007
REPORTING_SERVICE_PORT=3008
AI_MANAGER_SERVICE_PORT=3009
RESERVATION_SERVICE_PORT=3010
STORE_SERVICE_PORT=3011

CUSTOMER_SERVICE_PORT=3012
CHURN_SERVICE_PORT=3013
MARKETING_SERVICE_PORT=3014
STAFF_SERVICE_PORT=3015

# ============================================================
# INTER-SERVICE URLS (used by API Gateway and service-to-service calls)
# ============================================================

AUTH_SERVICE_URL=http://localhost:3004
ORDER_SERVICE_URL=http://localhost:3001
MENU_SERVICE_URL=http://localhost:3005
INVENTORY_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3003
CUSTOMER_SERVICE_URL=http://localhost:3012
MARKETING_SERVICE_URL=http://localhost:3014
REPORTING_SERVICE_URL=http://localhost:3008
STORE_SERVICE_URL=http://localhost:3011
NOTIFICATION_SERVICE_URL=http://localhost:3007
SYNC_SERVICE_URL=http://localhost:3006
CHURN_SERVICE_URL=http://localhost:3013
RESERVATION_SERVICE_URL=http://localhost:3010
AI_MANAGER_SERVICE_URL=http://localhost:3009

# ============================================================
# API GATEWAY
# ============================================================

ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5001,http://localhost:5002,http://localhost:5003,http://localhost:5004
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# ============================================================
# AUTH SERVICE
# ============================================================

JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ============================================================
# MENU SERVICE
# ============================================================

MENU_CACHE_TTL=3600

# ============================================================
# CUSTOMER SERVICE (loyalty engine thresholds)
# ============================================================

POINTS_PER_AED=0.1
TIER_GOLD_THRESHOLD=500
TIER_PLATINUM_THRESHOLD=2000
SEGMENT_ACTIVE_DAYS=7
SEGMENT_AT_RISK_DAYS=14
SEGMENT_CHURNED_DAYS=30
VIP_SPEND_THRESHOLD=5000

# ============================================================
# PAYMENT SERVICE (Stripe)
# ============================================================

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ============================================================
# CHURN ENGINE
# ============================================================

SCORING_SCHEDULE=0 2 * * *
CHURN_SCORE_THRESHOLD=0.7
RISK_SCORE_THRESHOLD=0.5

# ============================================================
# STAFF OPTIMIZATION SERVICE
# ============================================================

FORECAST_SCHEDULE=0 1 * * *
FORECAST_DAYS_AHEAD=7

# ============================================================
# SYNC SERVICE
# ============================================================

RECONCILIATION_BATCH_SIZE=50
RECONCILIATION_TIMEOUT_MS=30000

# ============================================================
# AI MANAGER SERVICE (WhatsApp Business API - optional)
# ============================================================

WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=pos-verify-token
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_ID=
# JSON map of manager phone numbers: {"store-id":"+971XXXXXXXXX"}
MANAGER_PHONE_MAP={}

# ============================================================
# MARKETING SERVICE
# ============================================================

DEFAULT_STORE_NAME=My Restaurant

# ============================================================
# FRONTEND APPS
# All 5 apps proxy through the API Gateway - only one URL needed
# ============================================================

VITE_API_BASE_URL=http://localhost:3000/api/v1